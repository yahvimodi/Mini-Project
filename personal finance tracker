import csv
import os
from collections import defaultdict
from datetime import datetime


DATA_FILE = "finance_data.csv"
FIELDS = ["date", "type", "category", "amount", "description"]


# ---------------------------------------------------------------- storage
def load_data(path=DATA_FILE):
    """Read transactions from a CSV file. Returns a list of dicts."""
    transactions = []
    if not os.path.exists(path):
        return transactions
    with open(path, newline="", encoding="utf-8") as f:
        reader = csv.DictReader(f)
        for row_no, row in enumerate(reader, start=2):
            tx = clean_row(row)
            if tx is None:
                print(f"  Skipped invalid row {row_no} in {path}")
                continue
            transactions.append(tx)
    return transactions


def save_data(transactions, path=DATA_FILE):
    """Write all transactions to a CSV file."""
    with open(path, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=FIELDS)
        writer.writeheader()
        for tx in transactions:
            writer.writerow(tx)


def clean_row(row):
    """Validate and normalise one row. Returns dict or None if invalid."""
    try:
        date = datetime.strptime(str(row["date"]).strip(), "%Y-%m-%d").strftime("%Y-%m-%d")
        tx_type = str(row["type"]).strip().lower()
        if tx_type not in ("income", "expense"):
            return None
        category = str(row["category"]).strip().title() or "Other"
        amount = float(row["amount"])
        if amount <= 0:
            return None
        description = str(row.get("description", "") or "").strip()
        return {"date": date, "type": tx_type, "category": category,
                "amount": round(amount, 2), "description": description}
    except (KeyError, ValueError, TypeError):
        return None


def import_file(transactions):
    """Ask the user for a CSV path and merge its rows into the data."""
    path = input("Enter path of the CSV file to import: ").strip().strip('"')
    if not os.path.isfile(path):
        print("  File not found.")
        return
    new = load_data(path)
    transactions.extend(new)
    save_data(transactions)
    print(f"  Imported {len(new)} transactions and saved.")
# ---------------------------------------------------------------- tables
def print_table(headers, rows):
    """Print a simple text table (no external libraries needed)."""
    rows = [[str(c) for c in r] for r in rows]
    widths = [len(h) for h in headers]
    for r in rows:
        for i, c in enumerate(r):
            widths[i] = max(widths[i], len(c))
    line = "+" + "+".join("-" * (w + 2) for w in widths) + "+"
    fmt = "| " + " | ".join("{:<%d}" % w for w in widths) + " |"
    print(line)
    print(fmt.format(*headers))
    print(line)
    for r in rows:
        print(fmt.format(*r))
    print(line)


def show_transactions(transactions):
    if not transactions:
        print("  No transactions yet.")
        return
    rows = [[i + 1, t["date"], t["type"], t["category"],
             f"{t['amount']:.2f}", t["description"]]
            for i, t in enumerate(sorted(transactions, key=lambda x: x["date"]))]
    print_table(["#", "Date", "Type", "Category", "Amount", "Description"], rows)


# ---------------------------------------------------------------- calculations
def totals(transactions):
    income = sum(t["amount"] for t in transactions if t["type"] == "income")
    expense = sum(t["amount"] for t in transactions if t["type"] == "expense")
    return income, expense, income - expense


def expenses_by_category(transactions):
    cat = defaultdict(float)
    for t in transactions:
        if t["type"] == "expense":
            cat[t["category"]] += t["amount"]
    return dict(sorted(cat.items(), key=lambda x: x[1], reverse=True))


def monthly_summary(transactions):
    months = defaultdict(lambda: [0.0, 0.0])
    for t in transactions:
        m = t["date"][:7]
        months[m][0 if t["type"] == "income" else 1] += t["amount"]
    return dict(sorted(months.items()))
# ---------------------------------------------------------------- summary
def build_summary(transactions):
    """Return the whole summary as a string (used for screen and file export)."""
    out = []
    income, expense, balance = totals(transactions)
    out.append("=" * 50)
    out.append("FINANCE SUMMARY")
    out.append("=" * 50)
    out.append(f"Total Income   : {income:12.2f}")
    out.append(f"Total Expenses : {expense:12.2f}")
    out.append(f"Balance        : {balance:12.2f}")
    if income > 0:
        out.append(f"Savings Rate   : {balance / income * 100:11.1f}%")

    cats = expenses_by_category(transactions)
    out.append("\nExpenses by Category")
    if cats:
        out.append(table_str(["Category", "Amount", "% of Expenses"],
                             [[c, f"{a:.2f}", f"{a / expense * 100:.1f}%"]
                              for c, a in cats.items()]))
        top = next(iter(cats))
        out.append(f"Highest spending category: {top} ({cats[top]:.2f})")
    else:
        out.append("  No expenses recorded.")

    months = monthly_summary(transactions)
    out.append("\nMonthly Summary")
    if months:
        out.append(table_str(["Month", "Income", "Expenses", "Net"],
                             [[m, f"{v[0]:.2f}", f"{v[1]:.2f}", f"{v[0] - v[1]:.2f}"]
                              for m, v in months.items()]))
    else:
        out.append("  No data.")
    return "\n".join(out)


def table_str(headers, rows):
    """Same as print_table but returns a string."""
    import io, contextlib
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        print_table(headers, rows)
    return buf.getvalue().rstrip()


def show_summary(transactions):
    if not transactions:
        print("  No data to summarise.")
        return
    print(build_summary(transactions))


def export_report(transactions):
    if not transactions:
        print("  No data to export.")
        return
    path = input("Report file name [report.txt]: ").strip() or "report.txt"
    with open(path, "w", encoding="utf-8") as f:
        f.write(build_summary(transactions) + "\n")
    print(f"  Report saved to {path}")


# ---------------------------------------------------------------- chart
def pie_chart(transactions):
    cats = expenses_by_category(transactions)
    if not cats:
        print("  No expenses to plot.")
        return
    try:
        import matplotlib
        import matplotlib.pyplot as plt
    except ImportError:
        print("  matplotlib is not installed. Run:  pip install matplotlib")
        return

    fig, ax = plt.subplots(figsize=(7, 7))
    ax.pie(list(cats.values()), labels=list(cats.keys()),
           autopct="%1.1f%%", startangle=90, pctdistance=0.8)
    ax.set_title("Expenses by Category")
    fig.tight_layout()
    fig.savefig("expense_pie_chart.png", dpi=150)
    print("  Chart saved as expense_pie_chart.png")
    try:
        plt.show()
    except Exception:
        pass
    plt.close(fig)
# ---------------------------------------------------------------- input
def add_transaction(transactions):
    date = input("Date (YYYY-MM-DD, blank = today): ").strip()
    if not date:
        date = datetime.today().strftime("%Y-%m-%d")
    tx_type = input("Type (income/expense): ").strip().lower()
    category = input("Category (e.g. Food, Rent, Salary): ").strip()
    amount = input("Amount: ").strip()
    description = input("Description (optional): ").strip()

    tx = clean_row({"date": date, "type": tx_type, "category": category or "Other",
                    "amount": amount, "description": description})
    if tx is None:
        print("  Invalid input. Nothing saved.")
        return
    transactions.append(tx)
    save_data(transactions)
    print("  Transaction saved.")


def delete_transaction(transactions):
    show_transactions(transactions)
    if not transactions:
        return
    ordered = sorted(transactions, key=lambda x: x["date"])
    try:
        n = int(input("Enter # to delete: "))
        removed = ordered[n - 1]
    except (ValueError, IndexError):
        print("  Invalid number.")
        return
    transactions.remove(removed)
    save_data(transactions)
    print("  Deleted.")


# ---------------------------------------------------------------- main
MENU = """
===== PERSONAL FINANCE TRACKER =====
1. Add transaction
2. Import transactions from a CSV file
3. View all transactions
4. Show summary (tables)
5. Show expense pie chart (category-wise)
6. Export report to text file
7. Delete a transaction
0. Exit
"""


def main():
    transactions = load_data()
    print(f"Loaded {len(transactions)} saved transactions from {DATA_FILE}")
    actions = {
        "1": add_transaction,
        "2": import_file,
        "3": show_transactions,
        "4": show_summary,
        "5": pie_chart,
        "6": export_report,
        "7": delete_transaction,
    }
    while True:
        print(MENU)
        choice = input("Choose an option: ").strip()
        if choice == "0":
            save_data(transactions)
            print("Data saved. Goodbye!")
            break
        action = actions.get(choice)
        if action:
            action(transactions)
        else:
            print("  Invalid choice.")


if __name__ == "__main__":
    main()
